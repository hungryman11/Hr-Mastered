# Django settings
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
MAX_LEAVE_WORKING_DAYS=15
DELIVERY_JOB_LEASE_SECONDS=300
DELIVERY_FAILURE_ALERT_EMAIL=ops@yourdomain.com

# Required, dedicated key for encrypting payroll bank/pension/tax fields at rest.
# Must NOT be the same as SECRET_KEY (see core/security.py) and must NOT be blank -
# the app will refuse to encrypt/decrypt payroll data without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FIELD_ENCRYPTION_KEY=change-me-generate-a-real-key-see-comment-above

# Database settings (strict PostgreSQL configuration)
POSTGRES_DB=hr_platform_db
POSTGRES_USER=hr_admin
POSTGRES_PASSWORD=ChangeThisInDev123!
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Zoho API settings
# These are placeholders. Never commit real values here - this file is meant to be
# shared/committed; put your real secrets only in your local, gitignored .env.
# For local development you don't need Infinity MFB's (or any org's) approval to get
# started: create a free personal/sandbox OAuth client in the Zoho API Console under
# your own account (redirect URI http://localhost:5173/app/callback is fine for dev).
# Org-wide approval is only needed later, when real staff of that org need to log in.
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ORG_ID=your_zoho_org_id
ZOHO_API_BASE_URL=https://www.zohoapis.com
# When True: WorkDrive/email calls are simulated AND the "Sign in with Zoho Mail"
# button skips the real accounts.zoho.com screen (no Zoho app/credentials needed at
# all to build/test the full login flow end-to-end).
ZOHO_USE_MOCK=True
# The default redirect_uri used as a fallback if a request doesn't specify one
# explicitly (the SPA always does, via getOAuthRedirectUri() in auth.ts, so this
# mainly matters for direct API testing). Point it at the frontend route, not the
# backend - Zoho must hand control back to the SPA (/app/callback), never straight
# to the Django API, or the user lands on raw JSON instead of the dashboard.
ZOHO_OAUTH_REDIRECT_URI=http://localhost:5173/app/callback
# Every redirect_uri the frontend is allowed to request, comma-separated. Must
# include the frontend origin(s) above, and each one must also be registered as a
# Redirect URI in the Zoho API Console.
# Add your deployed frontend origin here too once you have one, e.g.
# https://yourapp.onrender.com/app/callback
ZOHO_ALLOWED_REDIRECT_URIS=http://localhost:5173/app/callback,http://localhost:8000/app/callback
# Optional: limit sign-in to one company email domain, e.g. example.com
ZOHO_ALLOWED_EMAIL_DOMAIN=
# User-login scope only; WorkDrive uses the server-side integration credentials.
ZOHO_LOGIN_SCOPES=AaaServer.profile.READ

# Email settings (Zoho SMTP)
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_zoho_email@yourdomain.com
EMAIL_HOST_PASSWORD=your_zoho_app_password
EMAIL_USE_TLS=True

